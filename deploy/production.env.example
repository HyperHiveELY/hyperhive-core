# Template only. Fill privately in Phala encrypted environment settings.
# Never commit actual credentials or use these placeholders in a deployment.
NODE_ENV=production
SIGNER_MODE=phala
HOST=0.0.0.0
PORT=8788
PUBLIC_ORIGIN=https://YOUR_DOMAIN
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_DATABASE:5432/hyperhive?sslmode=verify-full
ELYSIUM_RPC=https://rpc.elysium.kinetiq.xyz
ROOT_CONTRACT=VERIFIED_SLIPROOT_ADDRESS
MEASUREMENT_HASH=INDEPENDENTLY_VERIFIED_MEASUREMENT
PPQ_API_KEY=ENTER_IN_HOST_SECRET_UI
PPQ_SCOUT_MODEL=openai/gpt-4.1-mini
PPQ_SKEPTIC_MODEL=anthropic/claude-haiku-4.5
PPQ_CALL_CEILING_USD=0.02
# Paste the validated public JSON exported from local Settings.
# Includes tokenPayTo, aiMarkupBps, terms/version/eligibility and contract settings.
INTEGRATION_SETTINGS=EXPORTED_PUBLIC_SETTINGS_JSON
LIVE_TRADING_ENABLED=false
# Behind the HTTPS reverse proxy, count requests per real client: the number of proxies in front of the API.
TRUSTED_PROXY_HOPS=1
# Worker only: private key that signs every reviewed trade card. Keep it in the host secret UI.
# CARD_SIGNING_KEY=ENTER_IN_HOST_SECRET_UI
# Omit unused optional address settings entirely, rather than empty strings.
# BUILDER_ADDRESS=VERIFIED_OPTIONAL_BUILDER
# TELEGRAM_BOT_TOKEN=ENTER_IN_HOST_SECRET_UI
# X402_FACILITATOR_TOKEN=ENTER_IN_HOST_SECRET_UI
# Public receiving address for Elysium USDC credit purchases.
ELYSIUM_CREDIT_PAY_TO=
