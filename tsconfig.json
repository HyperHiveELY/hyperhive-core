{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "apps",
    "packages",
    "scripts",
    "tests",
    "vite.config.ts"
  ]
}
