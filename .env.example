# Local browser/API. Production must use the same HTTPS origin for both.
PUBLIC_ORIGIN=http://localhost:5188
HOST=127.0.0.1
PORT=8788
NODE_ENV=development
# Run npm run db:local to create a dedicated local Postgres and configure .env.
# DATABASE_URL=postgresql://user:password@host:5432/hyperhive?sslmode=verify-full
# PPQ is entered through the local Setup dialog, not this tracked file.
PPQ_SCOUT_MODEL=openai/gpt-4.1-mini
PPQ_SKEPTIC_MODEL=anthropic/claude-haiku-4.5
PPQ_CALL_CEILING_USD=0.02
# These are public addresses/hashes returned by deployment and attestation.
# BUILDER_ADDRESS=0x...
# BILLING_CONTRACT=0x...
# ROOT_CONTRACT=0x...
# MEASUREMENT_HASH=0x...
ELYSIUM_RPC=https://rpc.elysium.kinetiq.xyz
DSTACK_SOCKET=/var/run/dstack.sock
# local: only on this computer, no Phala or subscription contract required.
# phala: hardware-attested deployment; default if omitted.
SIGNER_MODE=local
# Set true to allow execution; each crew still requires funding, approval and Start.
LIVE_TRADING_ENABLED=false
# Guided walkthrough for new visitors. false: it is only at /preview/walkthrough (unlisted).
# true: /demo, the demo links and the first-visit tour go live. Changing it needs a restart, not a rebuild.
WALKTHROUGH_ENABLED=false

# Optional paid record checks: Base mainnet USDC, with an authorized facilitator.
# X402_PAY_TO=0x...
# X402_FACILITATOR_URL=https://your-facilitator.example
# X402_FACILITATOR_TOKEN is an operator secret; inject through the host secret manager.

# Independent auditor host only (not the API or AI worker):
# AUDITOR_CONTRACT=0x...
# ARCHIVE_ORIGIN=https://your-hyperhive.example
# AUDITOR_PRIVATE_KEY_FILE=/run/secrets/auditor-key
# AUDITOR_STATE_DIR=/var/lib/hyperhive-auditor
# AUDITOR_EXECUTION_ENABLED=true

# Optional integration settings may also be configured in the local dashboard.
# HHIV_CONTRACT=0x...
# HHIV_BENEFIT_THRESHOLD=10000
# TELEGRAM_BOT_TOKEN is entered in the masked local Integrations form or host secrets.
# INTEGRATION_SETTINGS is the validated public-settings JSON exported by Hosting.
# Run npm run notifications alongside API, worker and signer (npm run local includes it).
