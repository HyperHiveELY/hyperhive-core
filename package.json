{
  "name": "hyperhive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env apps/api/main.ts",
    "web": "vite --host 127.0.0.1",
    "signer": "tsx --env-file-if-exists=.env apps/signer/main.ts",
    "worker": "tsx --env-file-if-exists=.env apps/worker/main.ts",
    "verify": "tsx scripts/verify.ts",
    "preflight": "tsx --env-file-if-exists=.env scripts/preflight.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run contracts:build && vitest run",
    "build": "npm run typecheck && vite build",
    "contracts:coverage": "tsx scripts/contract-coverage.ts",
    "contracts:build": "tsx scripts/contracts.ts",
    "start": "tsx --env-file-if-exists=.env apps/api/main.ts",
    "db:local": "tsx scripts/local-db.ts",
    "deploy:plan": "tsx --env-file-if-exists=.env scripts/deploy-plan.ts",
    "measurement": "tsx scripts/measurement.ts",
    "test:coverage": "npm run contracts:build && tsx scripts/test-postgres.ts --coverage",
    "test:postgres": "tsx --env-file-if-exists=.env scripts/test-postgres.ts",
    "auditor": "tsx --env-file-if-exists=.env apps/auditor/main.ts",
    "local": "tsx --env-file-if-exists=.env scripts/local-start.ts",
    "notifications": "tsx --env-file-if-exists=.env apps/worker/notifications.ts",
    "launch:check": "tsx --env-file-if-exists=.env scripts/launch-check.ts",
    "backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "backup:verify": "tsx --env-file-if-exists=.env scripts/backup.ts --verify",
    "release:package": "tsx scripts/release-package.ts",
    "ai:testing": "tsx --env-file-if-exists=.env scripts/ai-testing.ts",
    "paper": "tsx --env-file-if-exists=.env apps/paper/main.ts",
    "deploy:verify": "tsx --env-file-if-exists=.env scripts/verify-deployment.ts",
    "monitor": "tsx --env-file-if-exists=.env scripts/monitor.ts",
    "test:mutation": "stryker run"
  },
  "overrides": {
    "solc": {"tmp": "0.2.7"},
    "@stryker-mutator/core": {"minimatch": "11.0.1"},
    "typed-rest-client": {"qs": "6.17.1"}
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nktkas/hyperliquid": "0.33.3",
    "@openzeppelin/contracts": "5.6.1",
    "@phala/dcap-qvl": "0.7.1",
    "@phala/dstack-sdk": "0.5.8",
    "@x402/core": "2.30.0",
    "@x402/evm": "2.30.0",
    "@x402/fastify": "2.30.0",
    "fastify": "5.12.8",
    "lucide-react": "0.468.0",
    "parse5": "8.0.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "viem": "2.57.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "fast-check": "4.11.0",
    "solc": "0.8.39",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "packageManager": "npm@12.2.3"
}
